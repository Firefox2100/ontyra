  {
   "key": "fi-exp-proc",
   "kind": "procedure",
   "text": "File an expense report: collect itemised receipts, upload them to the expense portal within 30 days, pick the cost center, and submit for approval.",
   "fields": {
    "trigger": "file an expense report",
    "steps": [
     "collect itemised receipts",
     "upload them to the expense portal within 30 days of the purchase",
     "choose the cost center",
     "submit for manager approval"
    ]
   },
   "about": [
    "expense_report"
   ],
   "at": [
    "https://wiki.northwind.example/finance"
   ]
  },
