  {
   "key": "fi-vat-calc",
   "kind": "procedure",
   "text": "Work out VAT: gross = net \u00d7 1.21; to get the net from a gross amount divide by 1.21, and the VAT is the difference.",
   "fields": {
    "trigger": "calculate VAT on an amount",
    "steps": [
     "to add VAT multiply the net amount by 1.21",
     "to remove VAT divide the gross amount by 1.21",
     "the VAT amount is gross minus net"
    ]
   },
   "about": [
    "vat"
   ]
  },
  {
   "key": "fi-margin",
   "kind": "procedure",
   "text": "Gross margin percent is revenue minus cost of goods sold, divided by revenue; never divide by cost.",
   "fields": {
    "trigger": "calculate gross margin",
    "steps": [
     "subtract cost of goods sold from revenue",
     "divide the result by revenue",
     "express it as a percentage"
    ]
   },
   "about": [
    "gross_margin"
   ],
   "trap": [
    "opposite"
   ]
  },
  {
   "key": "fi-markup",
   "kind": "procedure",
   "text": "Markup percent is selling price minus cost, divided by cost.",
   "fields": {
    "trigger": "calculate markup",
    "steps": [
     "subtract cost from the selling price",
     "divide the result by cost",
     "express it as a percentage"
    ]
   },
   "about": [
    "markup"
   ],
   "trap": [
    "opposite"
   ],
   "note": "same words and a different denominator than fi-margin"
  },
  {
   "key": "fi-variance",
   "kind": "procedure",
   "text": "Budget variance is actual minus budget; costs above budget are unfavourable, revenue above budget is favourable.",
   "fields": {
    "trigger": "report budget variance",
    "steps": [
     "compute actual minus budget",
     "label cost overruns unfavourable and revenue overruns favourable",
     "explain every variance above 5%"
    ]
   },
   "about": [
    "budget_variance"
   ],
   "at": [
    "https://wiki.northwind.example/finance"
   ]
  },
