# Copy to .env (git-ignored). Compose reads it.
ONTYRA_DB_PASSWORD=change-me
# ONTYRA_AUTH_TOKEN=   # at least 16 characters; clients then send it as ONTYRA_TOKEN
ONTYRA_PORT=8787
ONTYRA_DB_PORT=18787
# ONTYRA_EMBED_MODEL=qwen3-embedding-8b
# ONTYRA_EMBED_URL=http://127.0.0.1:8081/v1
# ONTYRA_EMBED_DIM=4096
# ONTYRA_ABSTAIN_COSINE=0.452   # calibrate per embedder
# ONTYRA_DECISION_PROVIDER=systemone   # optional decision model (needs the fusion engine)
# ONTYRA_DECISION_URL=http://127.0.0.1:8083/v1
# ONTYRA_DECISION_MODEL=kev-9b

# The daemon runs as this user and writes its scheduled exports (./backups) as it: use your own
# (`id -u`, `id -g`) so the files are yours and ./backups is writable.
# ONTYRA_UID=1000
# ONTYRA_GID=1000
# Scheduled exports: every this many hours (0 turns them off), keeping the newest N.
# ONTYRA_BACKUP_EVERY_HOURS=24
# ONTYRA_BACKUP_KEEP=14
